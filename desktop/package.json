{
	"name": "liyuan-desktop",
	"private": true,
	"version": "1.6.2",
	"description": "梨园桌面版封装（Electron 壳；产品代码由 scripts/stage-desktop.mjs 装入 app/）",
	"main": "main.mjs",
	"scripts": {
		"dev": "electron main.mjs --dev",
		"stage": "node ../scripts/stage-desktop.mjs",
		"build:win": "node ../scripts/stage-desktop.mjs && electron-builder --win zip nsis",
		"build:mac": "node ../scripts/stage-desktop.mjs && electron-builder --mac dmg",
		"build:linux": "node ../scripts/stage-desktop.mjs && electron-builder --linux AppImage"
	},
	"devDependencies": {
		"electron": "^44.3.0",
		"electron-builder": "^26.15.3",
		"electron-updater": "^6.8.0"
	}
}
