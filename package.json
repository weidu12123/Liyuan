{
	"name": "liyuan",
	"version": "1.6.2",
	"description": "梨园（Liyuan）— 以 AI 为主演的角色扮演剧院",
	"scripts": {
		"test": "node --test test/*.test.ts",
		"runtime:build": "node scripts/build-runtime.mjs",
		"web": "node server/main.ts",
		"web:new": "node server/main.ts --new",
		"web:build": "npm --prefix web run build",
		"web:dev": "npm --prefix web run dev",
		"pack:release": "powershell -NoProfile -File scripts/pack-release.ps1 -Target all",
		"pack:release:windows": "powershell -NoProfile -File scripts/pack-release.ps1 -Target windows",
		"pack:release:linux": "powershell -NoProfile -File scripts/pack-release.ps1 -Target linux",
		"pack:release:macos": "powershell -NoProfile -File scripts/pack-release.ps1 -Target macos",
		"desktop:stage": "node scripts/stage-desktop.mjs",
		"desktop:dev": "npm --prefix desktop run dev",
		"desktop:build:win": "npm --prefix desktop run build:win",
		"desktop:build:mac": "npm --prefix desktop run build:mac",
		"desktop:build:linux": "npm --prefix desktop run build:linux"
	},
	"license": "PolyForm-Noncommercial-1.0.0",
	"type": "module",
	"dependencies": {
		"@liyuan/agent-runtime": "file:./packages/coding-agent",
		"@liyuan/ai": "file:./packages/ai",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/hosted-git-info": "3.0.5",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"@types/ws": "8.18.1",
		"playwright": "^1.49.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	}
}
